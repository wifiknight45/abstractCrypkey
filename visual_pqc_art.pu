# -------------------------------------------------------------------
# Mode handlers
# -------------------------------------------------------------------

def run_demo_mode(args):
    """
    DEMO MODE:
      - Visual experimentation only.
      - Not for cryptographic use.
    """
    os.makedirs(args.output_dir, exist_ok=True)
    for i in range(args.count):
        seed = random.getrandbits(64)
        img = generate_chaotic_canvas(
            width=args.width,
            height=args.height,
            seed=seed,
            complexity=args.complexity
        )
        uid = uuid.uuid4().hex
        fname = f"DEMO_ONLY_{uid}.png"
        path = os.path.join(args.output_dir, fname)
        img.save(path)
        register_image(path, mode="DEMO")
        print(f"[DEMO] Saved: {path}")


def run_soldier_mode(args):
    """
    SOLDIER MODE:
      - Generates higher-definition, more complex images.
      - Provides hooks for PQC seed derivation and key generation.
      - This script is NOT a complete or approved cryptographic system.
    """
    os.makedirs(args.output_dir, exist_ok=True)
    for i in range(args.count):
        seed = random.getrandbits(64)
        img = generate_chaotic_canvas(
            width=args.width,
            height=args.height,
            seed=seed,
            complexity=max(args.complexity, 1.5)  # push complexity up
        )
        uid = uuid.uuid4().hex
        fname = f"SOLDIER_{uid}.png"
        path = os.path.join(args.output_dir, fname)
        img.save(path)
        register_image(path, mode="SOLDIER")
        print(f"[SOLDIER] Saved image: {path}")

        if args.pqc_demo:
            # Demonstrate the flow ONLY (not real crypto)
            pqc_seed = derive_pqc_seed_from_image(img, mode="SOLDIER")
            print(f"  -> Derived dummy PQC seed (len={len(pqc_seed)} bytes).")
            try:
                generate_pqc_keys_from_seed(pqc_seed)
            except NotImplementedError as e:
                print(f"  -> PQC keygen hook: {e}")


# -------------------------------------------------------------------
# CLI
# -------------------------------------------------------------------

def parse_args():
    p = argparse.ArgumentParser(
        description="Generate chaotic colorful images in DEMO or SOLDIER mode."
    )
    p.add_argument(
        "--mode",
        choices=["demo", "soldier"],
        required=True,
        help="demo = visual only; soldier = high-def + PQC hooks (no real crypto)."
    )
    p.add_argument("--width", type=int, default=1920, help="Image width in pixels.")
    p.add_argument("--height", type=int, default=1080, help="Image height in pixels.")
    p.add_argument("--count", type=int, default=3, help="Number of images to generate.")
    p.add_argument(
        "--complexity",
        type=float,
        default=1.0,
        help="Visual complexity factor (roughly 0.5–3.0+)."
    )
    p.add_argument(
        "--output-dir",
        type=str,
        default="output_images",
        help="Directory to save generated images."
    )
    p.add_argument(
        "--pqc-demo",
        action="store_true",
        help="In soldier mode, run PQC seed derivation + keygen HOOK (still not real crypto)."
    )
    return p.parse_args()


def main():
    args = parse_args()
    if args.mode == "demo":
        print("Running in DEMO MODE (visual only, NOT for crypto).")
        run_demo_mode(args)
    elif args.mode == "soldier":
        print("Running in SOLDIER MODE (high-def visuals + PQC HOOKS ONLY).")
        print("This script is NOT a production cryptographic system.")
        run_soldier_mode(args)
    else:
        raise ValueError("Unknown mode")


if __name__ == "__main__":
    main()d
